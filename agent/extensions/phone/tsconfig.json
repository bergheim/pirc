{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"]
    },
    "include": ["./**/*.ts", "./**/*.d.ts"]
}
