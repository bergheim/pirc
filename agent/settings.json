{
  "theme": "bergheim-ansi-light/bergheim-ansi-dark",
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5",
  "enabledModels": [
    "xai/grok-4.6",
    "claude-bridge/claude-fable-5",
    "openai-codex/gpt-5.6-sol",
    "claude-bridge/claude-opus-5",
    "openai-codex/gpt-5.6-terra",
    "agy/gemini-3.7-flash",
    "llama/bot-fast"
  ],
  "npmCommand": [
    "pnpm",
    "--config.node-linker=hoisted",
    "--config.strict-dep-builds=false",
    "--config.strict-peer-dependencies=false"
  ],
  "packages": [
    "npm:pi-downshift",
    "npm:@juicesharp/rpiv-advisor",
    "npm:pi-themes",
    "npm:pi-web-access",
    "npm:pi-vim",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-lens",
      "skills": []
    },
    "npm:pi-system-prompt",
    "npm:pi-claude-bridge",
    "git:github.com/earendil-works/pi-review",
    "git:github.com/earendil-works/pi-review-loop",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/bergheim/pi-xmpp",
    "npm:@upstash/context7-pi"
  ],
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "medium",
  "compactToolsDensity": "title",
  "externalEditor": "emacsclient -t",
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "treeFilterMode": "user-only",
  "quietStartup": true,
  "piVim": {
    "modeColors": {
      "insert": "borderAccent",
      "normal": "borderMuted",
      "visual": "customMessageLabel",
      "ex": "warning"
    }
  }
}
